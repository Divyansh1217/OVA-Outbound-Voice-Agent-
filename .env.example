# LiveKit Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-secret-here

# AI Provider API Keys
GROQ_API_KEY=gsk_xxxxxxxx
DEEPGRAM_API_KEY=your-deepgram-key

# SIP Configuration (for outbound calling)
SIP_OUTBOUND_TRUNK_ID=ST_tx6WUovXopEP
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxx

# Optional: reference to the recorded call audio (e.g. a LiveKit Egress URL).
# When unset, only the LiveKit room name is logged to Opik.
# CALL_RECORDING_URL=https://example.com/recordings/call-123.mkv

# Optional: model used by the LLM-as-judge evaluation (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Opik Configuration
OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-workspace
# OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_PROJECT_NAME=healthcare-voice-agent
